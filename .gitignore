# Dependencies
node_modules/
*/node_modules/

# Production / Build output
dist/
*/dist/
build/
*.tsbuildinfo

# Environment variables & secrets (prevent leaking API keys)
.env
.env.*
!.env.example
*.local

# Python caches
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.coverage

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS & Editor
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo

# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
